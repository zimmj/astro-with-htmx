---
import { currentLocation, polarsteps } from '../lib/journey';

interface Props {
  city?: string;
  country?: string;
}

const { city = currentLocation.city, country = currentLocation.country } = Astro.props;
---

<a
  href={polarsteps.profileUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-1.5 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:border-blue-300 hover:text-blue-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-blue-700 dark:hover:text-blue-400"
>
  <span class="relative flex h-2 w-2">
    <span
      class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
    ></span>
    <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
  </span>
  Currently in {city}, {country}
</a>
