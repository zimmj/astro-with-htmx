---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/writing', label: 'Writing' },
  { href: '/journey', label: 'Journey' },
  { href: '/library', label: 'Library' },
];

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header class="border-b border-gray-200 dark:border-gray-800">
  <nav class="container mx-auto flex flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="font-semibold text-gray-900 dark:text-white">Joel Zimmerli</a>
    <ul class="flex flex-wrap gap-6 text-sm font-medium">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'transition-colors hover:text-blue-600 dark:hover:text-blue-400',
                isActive(link.href)
                  ? 'text-blue-600 dark:text-blue-400'
                  : 'text-gray-600 dark:text-gray-400',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
