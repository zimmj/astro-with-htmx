---
/**
 * There's no official Polarsteps embed widget, so this loads a public
 * Polarsteps page directly in an iframe (it sends no X-Frame-Options / CSP
 * frame-ancestors header, so browsers allow it) — either a trip page or the
 * profile page's world map. Renders the page as-is, Polarsteps header
 * included — we can't reach into a cross-origin iframe's DOM/CSS to strip
 * it, and proxying the page through our own origin to do so breaks their
 * app's own data fetching (its API calls have no CORS allowance and would
 * be blocked once served from a different origin).
 */
interface Props {
  url: string;
  title: string;
  /** Visible height of the embed, in pixels. */
  height?: number;
}

const { url, title, height = 640 } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-gray-200 shadow-lg dark:border-gray-700">
  <iframe src={url} title={title} loading="lazy" class="w-full border-0" style={`height: ${height}px;`}
  ></iframe>
</div>
