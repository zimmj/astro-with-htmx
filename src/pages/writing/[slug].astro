---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { estimateReadingTime } from '../../lib/reading-time';
import { formatLabels, pillarLabels } from '../../lib/writing';

const { slug } = Astro.params;
const post = slug ? await getEntry('writing', slug) : undefined;

if (!post || (post.data.draft && !import.meta.env.DEV)) {
  return new Response('Not found', { status: 404 });
}

const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main class="container mx-auto min-h-screen px-4 py-12 md:py-20">
    <article class="mx-auto max-w-2xl">
      <a
        href="/writing"
        class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
      >
        &larr; Back to Writing
      </a>

      <header class="mb-8">
        <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium text-gray-500 dark:text-gray-400">
          <span class="rounded-full bg-blue-100 px-2.5 py-1 text-blue-700 dark:bg-blue-900 dark:text-blue-300">
            {formatLabels[post.data.format]}
          </span>
          <span>{pillarLabels[post.data.pillar]}</span>
          <span>&middot;</span>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>&middot;</span>
          <span>{estimateReadingTime(post.body ?? '')} min read</span>
          {post.data.location && (
            <>
              <span>&middot;</span>
              <span>{post.data.location}</span>
            </>
          )}
        </div>
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl">{post.data.title}</h1>
        {post.data.updatedDate && (
          <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
            Last updated{' '}
            {post.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        )}
      </header>

      <div class="prose prose-gray dark:prose-invert max-w-none">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
