---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { estimateReadingTime } from '../../lib/reading-time';
import { formatLabels, pillarLabels } from '../../lib/writing';

const posts = await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing" description="Essays, observations, notes, and open questions.">
  <main class="container mx-auto min-h-screen px-4 py-12 md:py-20">
    <header class="mx-auto mb-12 max-w-2xl text-center">
      <h1 class="mb-3 text-4xl font-bold text-gray-900 dark:text-white md:text-5xl">Writing</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        Thoughts on technology, travel, and everything in between.
      </p>
    </header>

    <div class="mx-auto max-w-3xl space-y-6">
      {
        posts.length === 0 && (
          <p class="text-center text-gray-600 dark:text-gray-400">Nothing published yet — check back soon.</p>
        )
      }
      {
        posts.map((post) => (
          <a
            href={`/writing/${post.id}`}
            class="group block rounded-2xl border border-gray-200 bg-white p-6 shadow-lg transition-all hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800"
          >
            <div class="mb-3 flex flex-wrap items-center gap-2 text-xs font-medium text-gray-500 dark:text-gray-400">
              <span class="rounded-full bg-blue-100 px-2.5 py-1 text-blue-700 dark:bg-blue-900 dark:text-blue-300">
                {formatLabels[post.data.format]}
              </span>
              <span>{pillarLabels[post.data.pillar]}</span>
              <span>&middot;</span>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span>&middot;</span>
              <span>{estimateReadingTime(post.body ?? '')} min read</span>
              {post.data.draft && (
                <span class="rounded-full bg-amber-100 px-2.5 py-1 text-amber-700 dark:bg-amber-900 dark:text-amber-300">
                  Draft
                </span>
              )}
            </div>
            <h2 class="mb-2 text-2xl font-bold text-gray-900 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
              {post.data.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-400">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
