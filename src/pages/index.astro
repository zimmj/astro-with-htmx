---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Joel Zimmerli - Full Stack Developer"
  description="Personal website of Joel Zimmerli, Full Stack Developer"
  author="Joel Zimmerli"
  keywords="full stack developer, web development, software engineer"
>
  <main class="container mx-auto min-h-screen px-4 py-12 md:py-20">
    <!-- Header Section -->
    <header class="mb-12 text-center md:mb-16">
      <div class="mb-6 flex justify-center">
        <div
          class="h-32 w-32 overflow-hidden rounded-full border-4 border-gray-200 bg-gradient-to-br from-blue-500 to-purple-600 shadow-lg dark:border-gray-700"
        >
          <!-- Placeholder avatar with initials -->
          <div class="flex h-full w-full items-center justify-center text-5xl font-bold text-white">
            JZ
          </div>
        </div>
      </div>
      <h1 class="mb-3 text-4xl font-bold text-gray-900 dark:text-white md:text-5xl lg:text-6xl">
        Joel Zimmerli
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400 md:text-2xl">
        Full Stack Developer
      </p>

      <!-- Social Links -->
      <div class="mt-6 flex justify-center gap-4">
        <a
          href="https://github.com/joelzimmerli"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white transition-transform hover:scale-105 hover:bg-gray-800 dark:bg-gray-700 dark:hover:bg-gray-600"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
          GitHub
        </a>
        <a
          href="#"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-transform hover:scale-105 hover:bg-blue-700"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"
            ></path>
          </svg>
          LinkedIn
        </a>
      </div>
    </header>

    <!-- Cards Grid -->
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- About Card -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800"
        >
          <div class="mb-4 flex items-center gap-3">
            <div class="rounded-lg bg-blue-100 p-3 dark:bg-blue-900">
              <svg
                class="h-6 w-6 text-blue-600 dark:text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">About</h2>
          </div>
          <p class="mb-6 text-gray-600 dark:text-gray-400">
            Learn more about my background, experience, and what drives me as a developer.
          </p>
          <button
            hx-get="/api/cards/about"
            hx-target="#card-modal"
            hx-swap="innerHTML"
            class="inline-flex items-center gap-2 font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
          >
            Read more
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>

        <!-- Projects Card -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800"
        >
          <div class="mb-4 flex items-center gap-3">
            <div class="rounded-lg bg-purple-100 p-3 dark:bg-purple-900">
              <svg
                class="h-6 w-6 text-purple-600 dark:text-purple-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Projects</h2>
          </div>
          <p class="mb-6 text-gray-600 dark:text-gray-400">
            Explore my portfolio of web applications, tools, and open-source contributions.
          </p>
          <button
            hx-get="/api/cards/projects"
            hx-target="#card-modal"
            hx-swap="innerHTML"
            class="inline-flex items-center gap-2 font-medium text-purple-600 transition-colors hover:text-purple-700 dark:text-purple-400 dark:hover:text-purple-300"
          >
            View projects
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>

        <!-- Skills Card -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800"
        >
          <div class="mb-4 flex items-center gap-3">
            <div class="rounded-lg bg-emerald-100 p-3 dark:bg-emerald-900">
              <svg
                class="h-6 w-6 text-emerald-600 dark:text-emerald-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                ></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Skills</h2>
          </div>
          <p class="mb-6 text-gray-600 dark:text-gray-400">
            Technologies, frameworks, and tools I work with to build modern applications.
          </p>
          <button
            hx-get="/api/cards/skills"
            hx-target="#card-modal"
            hx-swap="innerHTML"
            class="inline-flex items-center gap-2 font-medium text-emerald-600 transition-colors hover:text-emerald-700 dark:text-emerald-400 dark:hover:text-emerald-300"
          >
            See skills
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>

        <!-- Contact Card -->
        <div
          class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 shadow-lg transition-all hover:shadow-2xl dark:border-gray-700 dark:bg-gray-800"
        >
          <div class="mb-4 flex items-center gap-3">
            <div class="rounded-lg bg-amber-100 p-3 dark:bg-amber-900">
              <svg
                class="h-6 w-6 text-amber-600 dark:text-amber-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Contact</h2>
          </div>
          <p class="mb-6 text-gray-600 dark:text-gray-400">
            Get in touch for collaborations, opportunities, or just to say hello.
          </p>
          <button
            hx-get="/api/cards/contact"
            hx-target="#card-modal"
            hx-swap="innerHTML"
            class="inline-flex items-center gap-2 font-medium text-amber-600 transition-colors hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300"
          >
            Contact me
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Modal Container (HTMX will load content here) -->
    <div id="card-modal"></div>
  </main>

  <script>
    // Close modal when clicking outside or pressing Escape
    document.addEventListener('htmx:afterSwap', (event) => {
      const modal = document.querySelector('[data-modal]');
      if (modal) {
        // Close on outside click
        modal.addEventListener('click', (e) => {
          if (e.target === modal) {
            modal.remove();
          }
        });

        // Close on Escape key
        const handleEscape = (e) => {
          if (e.key === 'Escape') {
            modal.remove();
            document.removeEventListener('keydown', handleEscape);
          }
        };
        document.addEventListener('keydown', handleEscape);
      }
    });
  </script>
</BaseLayout>
